java -> java (line "//" or block "/*" "*/")
js -> javascript (line "//")
jsx -> jsx (line "//")
lua -> lua (line "--")
md -> markdown (block "<!--" "-->")
mjs -> javascript (line "//")
php -> php (line "//" or block "/*" "*/")
py -> python (line "#")
rb -> ruby (line "#")
rs -> rust (line "//" or block "/*" "*/")
